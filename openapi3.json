{
  "openapi": "3.0.0",
  "info": {
    "title": "用户管理API",
    "description": "这是一个用于测试的用户管理API文档，展示了OpenAPI 3.0的完整功能",
    "version": "1.0.0",
    "contact": {
      "name": "API支持",
      "email": "support@example.com",
      "url": "https://example.com"
    }
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "开发服务器"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "获取用户列表",
        "description": "获取系统中的所有用户信息",
        "operationId": "getUsers",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "description": "页码",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 1,
              "minimum": 1
            }
          },
          {
            "name": "size",
            "in": "query",
            "description": "每页数量",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "description": "搜索关键字",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取用户列表",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200,
                      "description": "响应状态码"
                    },
                    "message": {
                      "type": "string",
                      "example": "操作成功",
                      "description": "响应消息"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "users": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/User"
                          }
                        },
                        "total": {
                          "type": "integer",
                          "example": 100,
                          "description": "总记录数"
                        },
                        "page": {
                          "type": "integer",
                          "example": 1,
                          "description": "当前页码"
                        },
                        "size": {
                          "type": "integer",
                          "example": 10,
                          "description": "每页大小"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "用户管理"
        ],
        "summary": "创建新用户",
        "description": "创建一个新的用户记录",
        "operationId": "createUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreateRequest"
              },
              "example": {
                "name": "张三",
                "email": "zhangsan@example.com",
                "age": 25,
                "gender": "男",
                "phone": "13800138000"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "用户创建成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 201,
                      "description": "响应状态码"
                    },
                    "message": {
                      "type": "string",
                      "example": "用户创建成功",
                      "description": "响应消息"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "请求参数错误",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/users/{id}": {
      "get": {
        "tags": [
          "用户管理"
        ],
        "summary": "获取指定用户",
        "description": "根据用户ID获取单个用户详细信息",
        "operationId": "getUserById",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "成功获取用户信息",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200,
                      "description": "响应状态码"
                    },
                    "message": {
                      "type": "string",
                      "example": "操作成功",
                      "description": "响应消息"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "用户管理"
        ],
        "summary": "更新用户信息",
        "description": "根据用户ID更新用户信息",
        "operationId": "updateUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdateRequest"
              },
              "example": {
                "name": "张三更新",
                "email": "zhangsan_updated@example.com",
                "age": 26,
                "gender": "男",
                "phone": "13800138001"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "用户更新成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200,
                      "description": "响应状态码"
                    },
                    "message": {
                      "type": "string",
                      "example": "用户更新成功",
                      "description": "响应消息"
                    },
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "用户管理"
        ],
        "summary": "删除用户",
        "description": "根据用户ID删除用户",
        "operationId": "deleteUser",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "用户ID",
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "用户删除成功",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "example": 200,
                      "description": "响应状态码"
                    },
                    "message": {
                      "type": "string",
                      "example": "用户删除成功",
                      "description": "响应消息"
                    },
                    "data": {
                      "type": "boolean",
                      "example": true
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "用户不存在",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "example": 1,
            "description": "用户唯一ID"
          },
          "name": {
            "type": "string",
            "example": "张三",
            "description": "用户姓名",
            "minLength": 1,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "zhangsan@example.com",
            "description": "用户邮箱"
          },
          "age": {
            "type": "integer",
            "example": 25,
            "description": "用户年龄",
            "minimum": 0,
            "maximum": 150
          },
          "gender": {
            "type": "string",
            "example": "男",
            "description": "用户性别",
            "enum": [
              "男",
              "女",
              "其他"
            ]
          },
          "phone": {
            "type": "string",
            "example": "13800138000",
            "description": "用户手机号"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T12:00:00Z",
            "description": "创建时间"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "example": "2023-01-01T12:00:00Z",
            "description": "更新时间"
          }
        }
      },
      "UserCreateRequest": {
        "type": "object",
        "required": [
          "name",
          "email"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "张三",
            "description": "用户姓名",
            "minLength": 1,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "zhangsan@example.com",
            "description": "用户邮箱"
          },
          "age": {
            "type": "integer",
            "example": 25,
            "description": "用户年龄",
            "minimum": 0,
            "maximum": 150
          },
          "gender": {
            "type": "string",
            "example": "男",
            "description": "用户性别",
            "enum": [
              "男",
              "女",
              "其他"
            ]
          },
          "phone": {
            "type": "string",
            "example": "13800138000",
            "description": "用户手机号"
          }
        }
      },
      "UserUpdateRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "张三更新",
            "description": "用户姓名",
            "minLength": 1,
            "maxLength": 50
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "zhangsan_updated@example.com",
            "description": "用户邮箱"
          },
          "age": {
            "type": "integer",
            "example": 26,
            "description": "用户年龄",
            "minimum": 0,
            "maximum": 150
          },
          "gender": {
            "type": "string",
            "example": "男",
            "description": "用户性别",
            "enum": [
              "男",
              "女",
              "其他"
            ]
          },
          "phone": {
            "type": "string",
            "example": "13800138001",
            "description": "用户手机号"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "example": 400,
            "description": "错误状态码"
          },
          "message": {
            "type": "string",
            "example": "请求参数错误",
            "description": "错误消息"
          },
          "details": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string",
                "example": "email必须是有效的邮箱格式"
              }
            },
            "description": "详细错误信息"
          }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "JWT Bearer token"
      }
    }
  },
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "用户管理",
      "description": "用户相关操作接口"
    }
  ]
}